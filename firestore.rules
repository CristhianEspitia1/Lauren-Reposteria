rules_version = '2';

// Centro de control de Lauren Repostería.
// - catalogo/actual: el catálogo publicado (`json`) y las preguntas frecuentes (`preguntas`). Lo lee cualquiera (la web lo muestra);
//   solo lo escribe un administrador con sesión iniciada y doble factor (app de códigos).
//   No guarda el correo de quien publica, porque es de lectura pública (si llega, debe ser el suyo).
// - historial: copia de cada versión guardada, con el correo de quien la publicó, para poder deshacer.
//   Solo administradores; nadie la cambia ni la borra.
// - fotos/subidas: los nombres de las fotos subidas desde el panel. Solo administradores.
// - Todo lo demás está cerrado.
// No hay registro público: los administradores se crean en la consola de Firebase.
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_second_factor == 'totp';
    }

    function version() {
      let data = request.resource.data;
      return data.keys().hasOnly(['json', 'preguntas', 'updatedAt', 'updatedBy'])
        && data.json is string
        && data.json.size() > 2
        && data.json.size() < 900000
        && (!('preguntas' in data) || (data.preguntas is string && data.preguntas.size() > 2 && data.preguntas.size() < 200000))
        && data.updatedAt == request.time
        && (!('updatedBy' in data) || data.updatedBy == request.auth.token.email);
    }

    match /catalogo/actual {
      allow read: if true;
      allow write: if admin() && version();
    }

    match /historial/{id} {
      allow read: if admin();
      allow create: if admin() && version() && 'updatedBy' in request.resource.data;
    }

    // Fotos subidas desde el panel (los archivos los guarda el worker de fotos): la lista que muestra
    // «Agregar fotos de la web». Siempre al día, a diferencia de la lista de claves de Cloudflare.
    match /fotos/subidas {
      allow read: if admin();
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['nombres', 'updatedAt'])
        && request.resource.data.nombres is list
        && request.resource.data.nombres.size() <= 5000
        && request.resource.data.updatedAt == request.time;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
